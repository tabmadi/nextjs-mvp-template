# Copy this file to .env, which git ignores. Never commit real values.

# The local PostgreSQL of compose.yaml. A provider URL uses sslmode=verify-full, per ADR-0200.
DATABASE_URL=postgres://app:local-development@127.0.0.1:5432/app_development?sslmode=disable

# The disposable test PostgreSQL of compose.yaml. Database tests use only this URL.
TEST_DATABASE_URL=postgres://app:local-test@127.0.0.1:5433/app_test?sslmode=disable
