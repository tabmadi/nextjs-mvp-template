{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.css",
      "!**/node_modules",
      "!**/.next",
      "!.config",
    ],
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": {
    "parser": { "tailwindDirectives": true },
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
    },
  },
  "linter": {
    "enabled": true,
    "domains": { "next": "recommended", "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "correctness": {
        // The resolver does not see Next 16 type-only re-exports from next/server.
        "noUnresolvedImports": "off",
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useImportType": "error",
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } },
      },
    },
  },
  // The domain stays pure, per ADR-0300: no React, database client, request type, or database module.
  "overrides": [
    {
      "includes": ["src/server/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "The domain imports no React, per ADR-0300.",
                  "react-dom": "The domain imports no React, per ADR-0300.",
                  "next": "The domain imports no request type, per ADR-0300.",
                  "pg": "The domain imports no database client, per ADR-0300.",
                  "drizzle-orm": "The domain imports no database client, per ADR-0300.",
                },
                "patterns": [
                  {
                    "group": [
                      "react/*",
                      "react-dom/*",
                      "next/*",
                      "drizzle-orm/*",
                      "pg/*",
                      "**/db",
                      "**/db/**",
                      "@/server/db",
                      "@/server/db/**",
                    ],
                    "message": "The domain imports no framework, database client, or database module, per ADR-0300.",
                  },
                ],
              },
            },
          },
        },
      },
    },
  ],
}
